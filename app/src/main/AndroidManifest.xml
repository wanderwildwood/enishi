<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The phone's own contacts store, which is the whole of what this app shows and changes.
         It keeps no copy of its own. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Which accounts contacts can be kept in, for a phone that syncs some. -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <!-- A press on a number calls it. Asked for the first time one is pressed; refused, the
         number goes to the dialer instead. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- The calls with a person, under their name, as the phone's own contacts app shows them. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Only for a birthday whose switch is on: it goes in a calendar of this app's own.
         Asked for the first time that switch is pressed. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Only so a scheduled backup is still scheduled after the phone restarts. Nothing runs
         at start-up: Android's job scheduler keeps the schedule. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- No INTERNET permission: nothing in this app can reach the network. The llama's
         address is handed to a browser. -->

    <!-- Which accounts sync contacts up to a server (DAVx5, Google…): since Android 11 another
         app's sync service is hidden unless asked for, and without it every server-kept
         person looked like a messenger's and could not be edited. -->
    <queries>
        <intent>
            <action android:name="android.content.SyncAdapter" />
        </intent>
        <!-- Medicine and Field Kit, so a person's More page can offer them only when they are
             on the phone (ui/Elsewhere.kt). -->
        <package android:name="com.wanderwildwood.fukuyaku" />
        <package android:name="com.wanderwildwood.zatsuno" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|fontScale|density|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "The contacts app", for anything that asks for it by category. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_CONTACTS" />
            </intent-filter>
        </activity>

        <!-- Every standard request another app makes of a contacts app. These are the ones
             Messaging and Email send, and the ones Android's own apps do.

             Its own task, never the address book's: a request that arrives as a new task
             would otherwise land on top of whatever the address book last had open, and
             finishing it would show that instead of going back to the app that asked. Kept
             out of recents for the same reason - it is a moment inside another app. -->
        <activity
            android:name=".AskActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|fontScale|density|locale|layoutDirection">

            <!-- Show a person: Messaging's contact link, a lookup, a raw contact. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <!-- Email's contact badge. -->
            <intent-filter>
                <action android:name="android.provider.action.QUICK_CONTACT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <!-- Add someone new: Messaging's "Add contact". -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/person" />
                <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
            </intent-filter>
            <!-- Add a number or an address to someone, or someone new: Email's. -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT_OR_EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <!-- Show whoever has this number or address, or offer to add them: Email's sender. -->
            <intent-filter>
                <action android:name="com.android.contacts.action.SHOW_OR_CREATE_CONTACT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
                <data android:scheme="mailto" />
            </intent-filter>
            <!-- Pick a person, a number, an email address or a postal address: Messaging's
                 contact card, Email's recipient. -->
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/person" />
                <data android:mimeType="vnd.android.cursor.dir/phone_v2" />
                <data android:mimeType="vnd.android.cursor.dir/phone" />
                <data android:mimeType="vnd.android.cursor.dir/email_v2" />
                <data android:mimeType="vnd.android.cursor.dir/postal-address_v2" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/phone_v2" />
                <data android:mimeType="vnd.android.cursor.item/email_v2" />
                <data android:mimeType="vnd.android.cursor.item/postal-address_v2" />
            </intent-filter>
            <!-- A contact card: one received in Messaging, or a whole book in a .vcf file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/directory" />
            </intent-filter>
        </activity>

        <!-- How a person is handed to another app as a .vcf: a content address with a one-off
             grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The scheduled backup, run by Android's job scheduler and nothing else. -->
        <service
            android:name=".data.BackupJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

    </application>

</manifest>
